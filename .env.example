# Bring your own API keys. All of these have free tiers.
#
# 1. Copy this file to `.env` (same folder). `.env` is git-ignored.
# 2. Paste your own keys after the `=`.
# 3. Never commit `.env` or share your keys.
#
# In the finished app you enter these in Settings on each device instead;
# they are stored only on that device.

# Speech-to-text. Get a key: https://console.groq.com/keys
GROQ_API_KEY=

# Notes, flashcards, study chat. Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Web search for the study chat. Get a key: https://app.tavily.com
TAVILY_API_KEY=
